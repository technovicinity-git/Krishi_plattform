# ─── Supabase API ─────────────────────────────────────────────────────────────
# Safe to expose in browser (public keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ⚠️ SERVER-ONLY — never expose to the browser, never commit
SUPABASE_SECRET_KEY=

# ─── Database (used only by scripts/migrate.js) ───────────────────────────────
# Server-only. Never imported by the frontend, never shipped to production.
# Get the connection string from:
#   Supabase Dashboard → Connect → Session pooler → Connection string
#
# Replace [YOUR-PASSWORD] with the database password.
# If the password contains special characters (& # ? / etc.), URL-encode them.
DATABASE_URL=

# Dev-only: show OTP on the verification screen. Remove in production.
# DEV_SHOW_OTP=true

# Session secret for custom authentication. Generate with:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
# KRISHI_SESSION_SECRET=

# Testing only: fixed OTP while SMS is not integrated.
# In development (npm run dev) the OTP is always 123456 by default.
# Set this only on a staging server to force a fixed code in production builds.
# NEVER set it on a live site.
# FIXED_OTP=123456
